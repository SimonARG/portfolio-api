APP_NAME="Simon Dev API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Spanish is the site's default locale; see REBUILD_PLAN.md §2.6.
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_AR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL. Locally this may be a unix socket path (/var/run/postgresql);
# in CI and on the VPS it is a host:port pair.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=portfolio
DB_USERNAME=portfolio
DB_PASSWORD=

# The API is stateless: Sanctum personal access tokens only, no sessions,
# no cookies, no CSRF. See REBUILD_PLAN.md §2.1.
SESSION_DRIVER=array
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis
CACHE_PREFIX=portfolio

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@simon-dev.com"
MAIL_FROM_NAME="${APP_NAME}"

# Origin allowed to call this API (CORS). Comma-separated.
FRONTEND_URL=http://localhost:3000

# Consumed by AdminUserSeeder (session 2). Never commit real values.
ADMIN_NAME="Simon Chasnovsky"
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Edge cache purge on publish (session 9). Zone id is in ~/portfolio/CLAUDE.md.
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=
